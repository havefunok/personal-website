---
import {getEntry,getCollection,render} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/ui/Media.astro';
import Link from '../components/ui/Link.astro';
import ContactBand from '../components/layout/ContactBand.astro';
import {site} from '../config/site';
import {displayDate} from '../lib/content';
const about=await getEntry('pages','about');
if(!about)throw new Error('About content is missing.');
const {Content}=await render(about);
const experience=(await getCollection('experience',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="About" description={about.data.description}>
 <header class="page-header"><p class="eyebrow">A little about me</p><h1>{about.data.title}</h1><p class="lede">{about.data.description}</p></header>
 <div class="page-grid"><aside class="page-aside">{site.portrait&&<Media src={site.portrait} alt={site.portraitAlt}/>}<dl><div><dt>Based in</dt><dd>{site.location}</dd></div><div><dt>Studying</dt><dd>{site.education}</dd></div></dl><Link href="/resume/">View my resume</Link></aside><div><div class="prose"><Content/></div>{experience.length>0&&<section class="experience" id="experience"><p class="eyebrow">Selected experience</p>{experience.map(({data:d})=><article class="experience-item"><div><h3>{d.organizationLink?<a href={d.organizationLink}>{d.organization}</a>:d.organization}</h3>{(d.startDate||d.current)&&<p class="meta">{displayDate(d.startDate)}{d.current?' — Present':d.endDate?` — ${displayDate(d.endDate)}`:''}</p>}{d.location&&<p class="meta">{d.location}</p>}</div><div><h3>{d.position}</h3><p>{d.description}</p>{d.achievements.length>0&&<ul class="prose">{d.achievements.map(a=><li>{a}</li>)}</ul>}{d.technologies.length>0&&<ul class="tag-list">{d.technologies.map(t=><li class="tag">{t}</li>)}</ul>}</div></article>)}</section>}</div></div><ContactBand/>
</BaseLayout>
