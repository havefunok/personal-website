---
import '../styles/global.css';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/layout/Footer.astro';
import {site,socialLinks} from '../config/site';
import {url} from '../lib/urls';
interface Props {title:string;description?:string;image?:string;type?:'website'|'article';noindex?:boolean;published?:Date;updated?:Date;}
const {title,description=site.description,image=site.seoImage,type='website',noindex=false,published,updated}=Astro.props;
const canonicalPath = noindex && /\/404\/?$/.test(Astro.url.pathname) ? url('/404.html') : Astro.url.pathname;
const canonical = new URL(canonicalPath,Astro.site).href;
const pageTitle = title===site.name?`${site.name} — Engineering & Beyond`:`${title} — ${site.name}`;
const socialImage = new URL(url(image),Astro.site).href;
const structured = type==='article' ? {'@context':'https://schema.org','@type':'BlogPosting',headline:title,description,url:canonical,image:socialImage,datePublished:published?.toISOString(),dateModified:(updated??published)?.toISOString(),author:{'@type':'Person',name:site.name,url:new URL(url('/about/'),Astro.site).href}} : {'@context':'https://schema.org','@type':'ProfilePage',name:pageTitle,url:canonical,mainEntity:{'@type':'Person',name:site.name,description:site.description,sameAs:socialLinks.map(l=>l.url)}};
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{pageTitle}</title><meta name="description" content={description}/><meta name="color-scheme" content="light dark"/>
  <link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href={url('/favicon.svg')}/>
  {noindex&&<meta name="robots" content="noindex,follow"/>}
  <meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={type}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={site.name}/><meta property="og:image" content={socialImage}/><meta property="og:image:alt" content={`${site.name} — ${site.headline}`}/>
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/>
  {published&&<meta property="article:published_time" content={published.toISOString()}/>}{updated&&<meta property="article:modified_time" content={updated.toISOString()}/>}
  <script is:inline>try{const p=localStorage.getItem('color-theme');document.documentElement.dataset.theme=(p==='light'||p==='dark')?p:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');}catch{}</script>
  <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\u003c')}/>
 </head>
 <body><Header/><main id="main" class="container" tabindex="-1"><slot/></main><Footer/></body>
</html>
